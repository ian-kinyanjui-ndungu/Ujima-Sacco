# Ujima SACCO Environment Variables
# ================================

# Application Settings
APP_NAME=Ujima SACCO Multi-Agent Backend
APP_ENV=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# CORS Configuration
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Compliance & Compliance Settings
STORAGE_REGION=af-south-1
DATA_PROTECTION_STANDARD=Kenya Data Protection Act 2022
COMPLIANCE_MODE=mock

# Database Configuration (if using)
DATABASE_URL=sqlite:///./ujima_sacco.db

# API Keys (if needed for external services)
# API_KEY=your_key_here
# SECRET_KEY=your_secret_here

# SMTP for Email Notifications (if needed)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_password

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ujima_sacco.log
